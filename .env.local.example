# ─── Cloudinary (free 25 GB, no credit card needed) ───────────────────────────
# Sign up at cloudinary.com → Dashboard shows these three values immediately
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Same as above — needed for browser-side URL construction
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API → service_role secret (NEVER expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
